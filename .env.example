# ==============================================================================
# SYNAPHEX — Environment Configuration Template
# ==============================================================================
# Note: This file contains placeholders ONLY. Do not place real credentials here.
# Copy this file to .env and supply actual values for your local development setup.

# Application Environment (development, staging, production)
APP_ENV=development
LOG_LEVEL=info

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# Security & CORS (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=change-this-insecure-secret-key-for-local-dev-only

# Relational Database (PostgreSQL)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/synaphex

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=synaphex_chunks_v1

# Private File Storage
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=25

# AI Provider Configuration (Provider-independent adapter layer)
# Supported LLM providers: openai, anthropic, ollama, mock
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Embedding Provider Configuration
# Supported Embedding providers: openai, fastembed, mock
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Optical Character Recognition (OCR)
OCR_ENABLED=false
TESSERACT_CMD=

# Authentication Provider Configuration
AUTH_PROVIDER=mock
AUTH_CONFIGURATION=
